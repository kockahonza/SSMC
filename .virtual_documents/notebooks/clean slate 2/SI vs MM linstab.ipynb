mm_u0 = [1., 0., 0.]
mm_p = make_mmicrm_problem(mm_ps, mm_u0, T)
@time mm_s = solve(mm_p, QNDF();
    callback=make_timer_callback(10.),
    abstol=tol,
    reltol=tol,
)
@show mmicrmmaxresid(mm_s), mm_s.u[end];
mm_fs = mm_s.u[end];


mm_mrls = linstab_simple(mm_ps, mm_Ds, mm_fs, ks)

fig = Figure()
