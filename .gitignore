# Don't track data files
data/**/*.jld2
data/**/*.h5

cluster_env/runs/**/*.h5
cluster_env/runs/**/*.jld2
cluster_env/runs/**/*.out
cluster_env/runs/**/.*

# SGE job logs on Myriad (<jobname>.e<jobid> / .o<jobid>)
cluster_env/**/*.e[0-9]*
cluster_env/**/*.o[0-9]*

notebooks/**/*.jld2
notebooks/**/*.h5

# Vendored third-party clones in rest/ - large data kept on disk only.
# See rest/microbiome-patterns/README.md for how to re-download or regenerate each.
rest/microbiome-patterns/data/
rest/microbiome-patterns/env1/
rest/microbiome-patterns/micrm_params_used/
rest/**/*.egg-info/
rest/**/.jupyter/

# Python bytecode caches
__pycache__/
*.pyc

# Windows/editor/jupyter friendliness
.DS_Store
.vscode
.ipynb_checkpoints

# jupyterlab-lsp mirrors of notebook code, regenerated on every notebook open
.virtual_documents/

# JupyterLab real-time collaboration state, regenerable and grows huge
.jupyter_ystore.db
.jupyter/collaboration_sessions.json

# Don't track nested git repos
latex_and_diagrams/overleaf_CRLS_git
