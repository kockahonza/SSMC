#!/bin/bash -l
#$ -N si_pdes1
#$ -cwd
#$ -l h_rt=12:00:00
#$ -pe smp 27
#$ -l mem=2G

# Myriad twin of job1.slurm. Note -l mem is per slot here, not per job as
# Slurm's --mem is: 27 x 2G = 54G for the job, on 36 core/188G nodes.
#
# 27 slots because main1 runs its 9 rows at once with 3 solver threads each.
# Asking for 27 rather than a whole node also places more easily - it fits any
# node with 27 cores free, not just an idle one.

time julia -t $NSLOTS --project -L base.jl -e 'main1()'
