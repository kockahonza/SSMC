#!/bin/bash -l
#$ -N si_pdes1_9
#$ -cwd
#$ -l h_rt=12:00:00
#$ -pe smp 9
#$ -l mem=5G

# The 9 slot variant, for getting scheduled rather than for speed: one thread
# per run, which is what pdes6's runtimes were measured at anyway.
#
# -l mem is per slot, so 9 x 5G = 45G for the job - the same total the 27 slot
# version asks for, since it is the same 9 concurrent solves either way.
#
# Writes to main1_myriad2/, not main1/, so it cannot collide with job1.qsub if
# both end up running.

time julia -t $NSLOTS --project -L base.jl -e 'main1_myriad2()'
